#!/bin/sh /etc/rc.common
# Net-Bond-007 multipath bonding client
START=95
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/net-bond-007 run --config /etc/net-bond-007/client.json
	# Routers have little RAM: keep the Go heap small.
	procd_set_param env GOMEMLIMIT=40MiB GOGC=50 GODEBUG=multipathtcp=0
	procd_set_param respawn 3600 2 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
